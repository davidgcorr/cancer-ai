{
  "name": "onco-milver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:anatomy": "node scripts/verify-anatomy.mjs",
    "verify:cancer-map": "node scripts/verify-cancer-map.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:reports": "node scripts/verify-reports.mjs",
    "check": "npm run lint && npm run verify:i18n && npm run verify:cancer-map && npm run verify:reports && npm run verify:anatomy",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^1.73.0",
    "open-anatomy-3d": "0.1.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.162.0"
  },
  "license": "MIT"
}
